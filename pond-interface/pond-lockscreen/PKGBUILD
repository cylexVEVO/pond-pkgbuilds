# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-lockscreen
pkgver=0.2.1.r20261107.2.g153163d
epoch=1
pkgrel=1
pkgdesc='Pond session lock and SDDM greeter'
arch=('x86_64')
url='https://github.com/cylexVEVO/pond-interface'
license=('BSD-3-Clause')
depends=(
  'coreutils'
  'glibc'
  'libgcc'
  'libstdc++'
  'networkmanager-qt'
  'pond-wallpaper'
  'qt6-base'
  'qt6-declarative>=6.12'
  'qt6-svg'
  'qt6-wayland'
  'quickshell>=0.3.1'
  'systemd'
  'ttf-onest'
  'wayland'
  'sddm'
  'niri'
)
makedepends=('cmake' 'ninja')
checkdepends=('dbus')

_commit=153163d166f2ac3f63974aa54dc045af8ece6db5
source=("pond-interface-$_commit.tar.gz::https://codeload.github.com/cylexVEVO/pond-interface/tar.gz/$_commit")
sha256sums=('6f8281f3d35663dfba8e396ff60f744bca04fda5f92eb5041bc44948ac80d0a5')

build() {
  cmake -S "pond-interface-$_commit" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON
  cmake --build build --target pond_systemplugin
}

check() {
  cmake -S "pond-interface-$_commit/tests/fingerprint-login" -B fingerprint-tests -G Ninja
  cmake --build fingerprint-tests
  dbus-run-session -- ./fingerprint-tests/fingerprint-login-test
}

package() {
  local destination="$pkgdir/usr/share/pond-interface"
  cd "pond-interface-$_commit"

  find lockscreen -type f \( -name '*.qml' -o -name '*.js' -o -name '*.png' -o -name '*.svg' \) \
    -exec install -Dm644 '{}' "$destination/{}" \;
  install -Dm644 lockscreen/greeter/{metadata.desktop,niri.kdl} -t "$destination/lockscreen/greeter"
  install -Dm644 lockscreen/greeter/sddm.conf "$pkgdir/usr/lib/sddm/sddm.conf.d/pond-lockscreen.conf"
  install -Dm755 "$srcdir/build/libpond_system.so" "$srcdir/build/Pond/System/libpond_systemplugin.so" \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/System"
  install -Dm644 "$srcdir/build/Pond/System/"{qmldir,pond_system.qmltypes} \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/System"
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/pond-interface/lockscreen "$pkgdir/etc/xdg/quickshell/pond-lockscreen"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
