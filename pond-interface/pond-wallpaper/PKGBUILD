# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-wallpaper
pkgver=0.2.0.r20261107.3.g399b1db
epoch=1
pkgrel=1
pkgdesc='Wallpaper manager for Pond'
arch=('any')
url='https://github.com/cylexVEVO/pond-interface'
license=('BSD-3-Clause')
depends=('python' 'python-pyqt6' 'qt6-declarative' 'qt6-imageformats' 'qt6-svg' 'qt6-wayland' 'quickshell' 'zenity')
makedepends=('qt6-shadertools')

_commit=399b1db1b38ecd1bf5830da1733543a75c8c4b63
source=("pond-interface-$_commit.tar.gz::https://codeload.github.com/cylexVEVO/pond-interface/tar.gz/$_commit")
sha256sums=('f8e118a25eaa6fb26d7b6e96cbd1302cdf925e0c1a0a1cff51d34ee7905a5daa')

build() {
  cd "pond-interface-$_commit/wallpaper/daylight"
  /usr/lib/qt6/bin/qsb --qt6 -o sky.frag.qsb sky.frag
}

package() {
  cd "pond-interface-$_commit"
  install -Dm644 wallpaper/daylight/{Sky.qml,SkyState.js,qmldir,sky.frag.qsb} \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/Daylight"
  install -Dm644 wallpaper/desktop/{qmldir,Window.qml,Content.qml,Reveal.qml} \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/Wallpaper"
  find wallpaper/desktop -maxdepth 1 -type f -name '*.qsb' \
    -exec install -Dm644 '{}' -t "$pkgdir/usr/lib/qt6/qml/Pond/Wallpaper" \;
  install -Dm755 wallpaper/control.py "$pkgdir/usr/share/pond-interface/wallpaper/control.py"
  install -Dm644 wallpaper/catalog.json "$pkgdir/usr/share/pond-interface/wallpaper/catalog.json"
  install -Dm644 wallpaper/included/*.jpg \
    -t "$pkgdir/usr/share/pond-interface/wallpaper/included"
  install -dm755 "$pkgdir/etc/skel/Pictures/Wallpapers"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
