# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-screenshot
pkgver=0.1.0.r20261107.3.g399b1db
epoch=1
pkgrel=1
pkgdesc='Default screenshotting tool for Pond'
arch=('x86_64')
url='https://github.com/cylexVEVO/pond-interface'
license=('BSD-3-Clause')
depends=(
  'niri>=26.04'
  'python'
  'qt6-declarative>=6.12'
  'qt6-svg'
  'qt6-wayland'
  'quickshell>=0.3.1'
  'ttf-onest'
  'wl-clipboard'
)
makedepends=('cmake' 'ninja')
_commit=399b1db1b38ecd1bf5830da1733543a75c8c4b63
source=("pond-interface-$_commit.tar.gz::https://codeload.github.com/cylexVEVO/pond-interface/tar.gz/$_commit")
sha256sums=('f8e118a25eaa6fb26d7b6e96cbd1302cdf925e0c1a0a1cff51d34ee7905a5daa')

build() {
  cmake -S "$srcdir/pond-interface-$_commit/screenshot/native" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  cd "pond-interface-$_commit"
  install -Dm644 screenshot/{qmldir,State.qml,Preview.qml,clipboard.py} \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/Screenshot"
  install -Dm644 screenshot/assets/*.svg \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/Screenshot/assets"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
