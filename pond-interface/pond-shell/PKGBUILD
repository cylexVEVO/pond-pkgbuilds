# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-shell
pkgver=0.2.0.r20261107.2.g153163d
epoch=1
pkgrel=1
pkgdesc='Pond desktop shell for niri'
arch=('any')
url='https://github.com/cylexVEVO/pond-interface'
license=('BSD-3-Clause')
install=pond-shell.install
depends=(
  'bluez'
  'brightnessctl'
  'capitaine-cursors'
  'ddcutil'
  'fastfetch'
  'gsettings-desktop-schemas'
  'imagemagick'
  'iw'
  'libcanberra'
  'networkmanager'
  'niri'
  'pipewire'
  'pond-lockscreen'
  'pond-pm'
  'pond-screenshot'
  'pond-wallpaper'
  'power-profiles-daemon'
  'python'
  'python-gobject'
  'python-pyqt6'
  'qt6-declarative'
  'qt6-imageformats'
  'qt6-svg'
  'qt6-wayland'
  'quickshell'
  'systemd'
  'ttf-advent-pro'
  'ttf-ibm-plex'
  'ttf-jetbrains-mono'
  'ttf-onest'
  'upower'
)
backup=(
  'etc/xdg/kitty/kitty.conf'
  'etc/xdg/fastfetch/config.jsonc'
  'etc/xdg/gtk-3.0/settings.ini'
  'etc/xdg/gtk-4.0/settings.ini'
)

_commit=153163d166f2ac3f63974aa54dc045af8ece6db5
source=("pond-interface-$_commit.tar.gz::https://codeload.github.com/cylexVEVO/pond-interface/tar.gz/$_commit")
sha256sums=('6f8281f3d35663dfba8e396ff60f744bca04fda5f92eb5041bc44948ac80d0a5')

package() {
  cd "pond-interface-$_commit"
  find shell -type f \( -name '*.qml' -o -name '*.js' -o -name 'qmldir' \
    -o -name '*.svg' -o -name '*.png' -o -name '*.py' -o -name '*.qsb' \) \
    -exec install -Dm644 '{}' "$pkgdir/usr/share/pond-interface/{}" \;
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/pond-interface/shell "$pkgdir/etc/xdg/quickshell/pond-shell"
  install -Dm644 config/applications/pond-manual.desktop -t "$pkgdir/usr/share/applications"

  install -Dm644 config/gtk-3.0/settings.ini "$pkgdir/etc/xdg/gtk-3.0/settings.ini"
  install -Dm644 config/gtk-4.0/settings.ini "$pkgdir/etc/xdg/gtk-4.0/settings.ini"
  install -Dm644 config/glib-2.0/*.gschema.override -t "$pkgdir/usr/share/glib-2.0/schemas"

  local defaults=/usr/share/pond-interface/config
  install -Dm644 config/niri/shell/*.kdl -t "$pkgdir$defaults/niri/shell"

  install -Dm644 config/kitty/etc/kitty.conf "$pkgdir/etc/xdg/kitty/kitty.conf"

  install -Dm644 config/fastfetch/config.jsonc "$pkgdir/etc/xdg/fastfetch/config.jsonc"
  install -Dm644 config/fastfetch/butterfly.png "$pkgdir$defaults/fastfetch/butterfly.png"
  install -Dm644 config/fastfetch/fastfetch-flowers.ttf "$pkgdir/usr/share/fonts/TTF/fastfetch-flowers.ttf"

  install -Dm644 config/niri/config.kdl "$pkgdir/etc/skel/.config/niri/config.kdl"
  install -Dm644 config/niri/cfg/*.kdl -t "$pkgdir/etc/skel/.config/niri/cfg"
  ln -s "$defaults/niri/shell" "$pkgdir/etc/skel/.config/niri/shell"
  install -Dm644 config/kitty/kitty.conf "$pkgdir/etc/skel/.config/kitty/kitty.conf"
  install -Dm644 config/kitty/themes/default.conf "$pkgdir$defaults/kitty/themes/default.conf"
  ln -s "$defaults/kitty/themes/default.conf" "$pkgdir/etc/skel/.config/kitty/current-theme.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
